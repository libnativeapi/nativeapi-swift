{#- Per-file template that generates Swift bindings for each IR source file -#}
{#- This template is rendered once per IR file -#}

{#- Import partial macros -#}
{% from 'partials/type.j2' import render_type %}
{% from 'partials/enum.j2' import render_enum %}
{% from 'partials/function.j2' import render_function %}
{% from 'partials/class.j2' import render_class %}
{% from 'partials/constant.j2' import render_constant %}
{% from 'partials/alias.j2' import render_alias %}

// =============================================================================
// Auto-generated Swift bindings for: {{ file_path }}
// {{ mapping.options.output_note | default("Generated by bindgen swift template.") }}
// =============================================================================

import Foundation
import CNativeAPI

{% if is_empty %}
// This file has no exported symbols.
{% else %}
// MARK: - Summary
//   Types:     {{ types | length }}
//   Enums:     {{ enums | length }}
//   Functions: {{ functions | length }}
//   Classes:   {{ classes | length }}
//   Constants: {{ constants | length }}
//   Aliases:   {{ aliases | length }}

{#- ========== Types (Structs) ========== -#}
{% if has_types %}
// MARK: - Types (Structs)

{% for item in types %}
{{ render_type(item, namer, mapping) }}

{% endfor %}
{% endif %}
{#- ========== Enums ========== -#}
{% if has_enums %}
// MARK: - Enums

{% for item in enums %}
{{ render_enum(item, namer) }}

{% endfor %}
{% endif %}
{#- ========== Constants ========== -#}
{% if has_constants %}
// MARK: - Constants

{% for item in constants %}
{{ render_constant(item, namer, mapping) }}

{% endfor %}
{% endif %}
{#- ========== Type Aliases ========== -#}
{% if has_aliases %}
// MARK: - Type Aliases

{% for item in aliases %}
{{ render_alias(item, namer, mapping) }}

{% endfor %}
{% endif %}
{#- ========== Functions ========== -#}
{% if has_functions %}
// MARK: - Functions

{% for item in functions %}
{{ render_function(item, namer, mapping) }}

{% endfor %}
{% endif %}
{#- ========== Classes ========== -#}
{% if has_classes %}
// MARK: - Classes

{% for item in classes %}
{{ render_class(item, namer, mapping) }}

{% endfor %}
{% endif %}
{% endif %}
// =============================================================================
// End of {{ file_name }}
// =============================================================================
