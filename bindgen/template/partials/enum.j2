{#- Enum template for Swift -#}
{%- macro enum_case_name(name, namer) -%}
{%- set base = namer.enum_value_name(name) -%}
{%- if base.startswith('k') and base|length > 1 and base[1].isupper() -%}
{{ base[1:2]|lower }}{{ base[2:] }}
{%- else -%}
{{ base }}
{%- endif -%}
{%- endmacro -%}

{%- macro render_enum(item, namer) -%}
public enum {{ namer.enum_name(item.name) }}: Int {
{%- for value in item.values %}
    case {{ enum_case_name(value.name, namer) }} = {{ value.value }}
{%- endfor %}
}
{%- endmacro -%}

{%- if item is defined -%}
{{ render_enum(item, namer) }}
{%- endif -%}
